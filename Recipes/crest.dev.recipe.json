{
  "name": "CrestDev",
  "displayName": "Orchard Crest UI Framework Dev",
  "description": "Minimal SQLite development setup for Orchard Crest UI Framework.",
  "author": "Orchard Crest UI Framework",
  "website": "https://github.com/jesse-forked/Crest",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [
    "default"
  ],
  "tags": [
    "dev",
    "crest",
    "sqlite"
  ],
  "variables": {
    "blazorCounterContentItemId": "4c1b6c1f8f5b4a2f9c2d7e8a1b3f5c6d",
    "legacyFrameWorkflowTypeId": "4crestlegacyframeworkflowtype001"
  },
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Admin",
        "OrchardCore.AdminMenu",
        "OrchardCore.ContentTypes",
        "OrchardCore.Contents",
        "OrchardCore.Deployment",
        "OrchardCore.Diagnostics",
        "OrchardCore.Features",
        "OrchardCore.Layers",
        "OrchardCore.Liquid",
        "OrchardCore.Media",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Roles",
        "OrchardCore.Settings",
        "OrchardCore.Shortcodes",
        "OrchardCore.Templates",
        "OrchardCore.Themes",
        "OrchardCore.Users",
        "OrchardCore.Widgets",
        "Crest",
        "Crest.Admin",
        "Crest.Site",
        "Crest.Member",
        "Crest.ContentPartLists",
        "TheAdmin",
        "SafeMode",
        "OrchardCore.Localization",
        "OrchardCore.Workflows",
        "Crest.LegacyFrame",
        "Crest.Icons",
        "Crest.Global",
        "Crest.Regions",
        "Crest.Money",
        "Crest.Parties",
        "Crest.Members",
        "Crest.Workflows",
        "Crest.Workflows.Contents"
      ]
    },
    {
      "name": "themes",
      "admin": "Crest.Admin",
      "site": "Crest.Site"
    },
    {
      "name": "settings",
      "SiteName": "Orchard Crest UI Framework Dev",
      "CurrentAdminThemeName": "Crest.Admin",
      "LocalizationSettings": {
        "DefaultCulture": "en-US",
        "SupportedCultures": [
          "en-US",
          "es-ES"
        ],
        "FallBackToParentCulture": true
      }
    },
    {
      "name": "WorkflowType",
      "Data": [
        {
          "WorkflowTypeId": "[js: variables('legacyFrameWorkflowTypeId')]",
          "Name": "Legacy frame smoke workflow",
          "IsEnabled": true,
          "IsSingleton": false,
          "LockTimeout": 0,
          "LockExpiration": 0,
          "DeleteFinishedWorkflows": false,
          "Activities": [],
          "Transitions": []
        }
      ]
    },
    {
      "name": "content",
      "Data": [
        {
          "ContentItemId": "[js: variables('blazorCounterContentItemId')]",
          "ContentType": "BlazorComponent",
          "DisplayText": "Blazor Counter (interactive-island test)",
          "Latest": true,
          "Published": true,
          "Owner": "[js: parameters('AdminUsername')]",
          "Author": "[js: parameters('AdminUsername')]",
          "CrestBlazorComponentPart": {
            "ComponentName": "CrestCounter",
            "Parameters": {
              "StartValue": "5"
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Editor",
          "Description": "Can edit site content.",
          "Permissions": [
            "EditContent",
            "ViewContent"
          ]
        },
        {
          "Name": "Author",
          "Description": "Can author site content.",
          "Permissions": [
            "EditOwnContent",
            "ViewContent"
          ]
        }
      ]
    }
  ]
}
