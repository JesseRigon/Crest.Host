<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>orchard-crest-host</UserSecretsId>
  </PropertyGroup>

  <Target Name="EnsureWwwRootExists" BeforeTargets="Build;Publish">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
  </Target>

  <ItemGroup>
    <Compile Remove="modules\**" />
    <Content Remove="modules\**" />
    <EmbeddedResource Remove="modules\**" />
    <None Remove="modules\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Recipes\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="OrchardCore.Application.Cms.Targets" />
    <PackageReference Include="OrchardCore.Logging.Serilog" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="modules/Crest/Crest.Server/Crest.csproj" />
    <ProjectReference Include="modules/Crest/Crest.ContentPartLists/Crest.ContentPartLists.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Parties/Server/Crest.Parties.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Parties/Domain/Crest.Parties.Domain.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Members/Server/Crest.Members.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Members/Domain/Crest.Members.Domain.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Workflows/Server/Crest.Workflows.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Workflows/Contents/Crest.Workflows.Contents.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Money/Crest.Money.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Money/Domain/Crest.Money.Domain.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Global/Crest.Global.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Regions/Crest.Regions.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Regions/Domain/Crest.Regions.Domain.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Server/Themes/Crest.LegacyFrame/Crest.LegacyFrame.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Components/Crest.Components.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Icons/Crest.Icons.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Admin/Crest.Admin.csproj" />
    <ProjectReference Include="modules/Crest/Crest.Site/Crest.Site.csproj" />
  </ItemGroup>
</Project>
