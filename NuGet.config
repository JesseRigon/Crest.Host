<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
    <!-- Each submodule packs its own packages (4.0.0-local) into its own output/ folder;
         dev/dev.sh packs them in dependency order - Crest's platform (src/, forked from
         OrchardCore), then Crest's modules - and creates the folders, which
         must exist for restore to run. The platform and Crest's modules share the Crest.*
         prefix, so both of those feeds carry the same patterns and restore looks in both. -->
    <add key="Platform" value="modules/Crest/output/platform" />
    <add key="Crest" value="modules/Crest/output/crest" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="NuGet">
      <package pattern="*" />
      <!-- Real, separately-published translations packages (the "All" meta-package and
           its per-culture dependents) are published from OrchardCore, not packed
           here, so they are never in a local feed. -->
      <package pattern="OrchardCore.Translations*" />
    </packageSource>
    <packageSource key="Platform">
      <package pattern="Crest.*" />
      <!-- Theme and test-sample packages without the Crest prefix. Without these mappings
           restore routes them to nuget.org and silently falls back to stale cache copies
           with mismatched assembly versions. -->
      <package pattern="TheAdmin*" />
      <package pattern="SafeMode*" />
      <package pattern="BaseThemeSample*" />
      <package pattern="DerivedThemeSample*" />
      <package pattern="Examples.Features*" />
    </packageSource>
    <packageSource key="Crest">
      <package pattern="Crest.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
