# Crest.Application.Cms.Targets' CopyPackageTranslationFiles build target copies
# each orchardcore.translations.* NuGet package's .po files into a "Localization/" folder
# at this project's own directory on every build - regenerated content, not source.
# Scoped to just that path (not a bare "Localization/" pattern) because the
# Crest submodule keeps genuinely hand-authored .po files in its own
# Localization/ folders (e.g. modules/Crest/Crest.Server/Localization/)
# that a broader rule would silently hide from git.
/Localization/
wwwroot/.well-known/acme-challenge/

# Generated by the dev tenant / test suite
recipes/crest-admin-menu-layout.json
tests/playwright/output/new/

# Admin suite run output; base/ holds committed baselines
dev/playwright-output/*
!dev/playwright-output/base/
