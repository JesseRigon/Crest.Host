{
  "name": "CrestDev",
  "displayName": "Crest Dev",
  "description": "Minimal SQLite development setup for a Crest host.",
  "author": "Crest",
  "website": "https://github.com/JesseRigon/Crest.Host",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [
    "default"
  ],
  "tags": [
    "dev",
    "crest",
    "sqlite"
  ],
  "variables": {
    "blazorCounterContentItemId": "4c1b6c1f8f5b4a2f9c2d7e8a1b3f5c6d"
  },
  "steps": [
    {
      "name": "feature",
      "enable": [
        "Crest.Admin",
        "Crest.AdminMenu",
        "Crest.ContentTypes",
        "Crest.Contents",
        "Crest.Deployment",
        "Crest.Diagnostics",
        "Crest.Features",
        "Crest.Layers",
        "Crest.Liquid",
        "Crest.Media",
        "Crest.Navigation",
        "Crest.Recipes",
        "Crest.Roles",
        "Crest.Settings",
        "Crest.Shortcodes",
        "Crest.Templates",
        "Crest.Themes",
        "Crest.Users",
        "Crest.Widgets",
        "Crest",
        "Crest.AdminTheme",
        "Crest.SiteTheme",
        "Crest.ContentPartLists",
        "TheAdmin",
        "SafeMode",
        "Crest.Localization",
        "Crest.LegacyFrame",
        "Crest.Icons",
        "Crest.Global",
        "Crest.Regions",
        "Crest.Money",
        "Crest.Parties",
        "Crest.Members",
        "Crest.Workflows",
        "Crest.Workflows.Contents",
        "Crest.Autoroute",
        "Crest.Email",
        "Crest.Email.Smtp",
        "Crest.DynamicCache",
        "Crest.Flows",
        "Crest.HomeRoute",
        "Crest.Html",
        "Crest.Recipes.Core",
        "Crest.Resources",
        "Crest.Roles.Core",
        "Crest.Security",
        "Crest.Tenants",
        "Crest.Title",
        "Crest.MemberTheme"
      ]
    },
    {
      "name": "themes",
      "admin": "Crest.AdminTheme",
      "site": "Crest.SiteTheme"
    },
    {
      "name": "settings",
      "SiteName": "Crest Dev",
      "CurrentAdminThemeName": "Crest.AdminTheme",
      "LocalizationSettings": {
        "DefaultCulture": "en-US",
        "SupportedCultures": [
          "en-US",
          "es-ES"
        ],
        "FallBackToParentCulture": true
      },
      "AdminSettings": {
        "DisplayThemeToggler": true,
        "DisplayMenuFilter": true,
        "DisplayNewMenu": true,
        "DisplayTitlesInTopbar": false
      }
    },
    {
      "name": "content",
      "Data": [
        {
          "ContentItemId": "[js: variables('blazorCounterContentItemId')]",
          "ContentType": "BlazorComponent",
          "DisplayText": "Blazor Counter (interactive-island test)",
          "Latest": true,
          "Published": true,
          "Owner": "[js: parameters('AdminUsername')]",
          "Author": "[js: parameters('AdminUsername')]",
          "CrestBlazorComponentPart": {
            "ComponentName": "CrestCounter",
            "Parameters": {
              "StartValue": "5"
            }
          }
        }
      ]
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Editor",
          "Description": "Can edit site content.",
          "Permissions": [
            "EditContent",
            "ViewContent"
          ]
        },
        {
          "Name": "Author",
          "Description": "Can author site content.",
          "Permissions": [
            "EditOwnContent",
            "ViewContent"
          ]
        },
        {
          "Name": "Moderator",
          "Description": "Grants users the ability to moderate content.",
          "Permissions": []
        },
        {
          "Name": "Contributor",
          "Description": "Grants users the ability to contribute content.",
          "Permissions": []
        },
        {
          "Name": "WorkflowEditor",
          "Description": "Authors the tenant's own workflows: view, edit, publish and run; not the shipped templates or connections (plans/workflows.md, phase 5).",
          "Permissions": [
            "AccessAdminPanel",
            "ViewCrestWorkflows",
            "EditCrestWorkflows",
            "PublishCrestWorkflows",
            "RunCrestWorkflows"
          ]
        },
        {
          "Name": "WorkflowViewer",
          "Description": "Reads workflows, instances and journals; changes nothing.",
          "Permissions": [
            "AccessAdminPanel",
            "ViewCrestWorkflows"
          ]
        }
      ]
    },
    {
      "name": "CrestAdminMenuLayout",
      "file": "crest-admin-menu-layout.json",
      "optional": true
    }
  ]
}
